{
  "display_information": { "name": "People Ops Bot", "description": "Joiner and leaver nudges from Notion, /people answers, and a People Ops assistant you can DM.", "background_color": "#2b2d42" },
  "features": {
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "people-ops", "always_online": true },
    "slash_commands": [ { "command": "/people", "url": "https://YOUR-PROJECT.vercel.app/api/slack", "description": "Find a policy, guide, form or next step", "usage_hint": "how do I apply for leave in Brazil?", "should_escape": false } ]
  },
  "oauth_config": { "scopes": { "bot": ["chat:write", "chat:write.public", "commands", "im:write", "im:history", "app_mentions:read", "channels:history", "groups:history"] } },
  "settings": {
    "event_subscriptions": { "request_url": "https://YOUR-PROJECT.vercel.app/api/slack", "bot_events": ["app_mention", "message.im"] },
    "interactivity": { "is_enabled": true, "request_url": "https://YOUR-PROJECT.vercel.app/api/slack" },
    "org_deploy_enabled": false, "socket_mode_enabled": false, "token_rotation_enabled": false
  }
}
