function buildDemo() {
  const ss = SpreadsheetApp.getActive();
  ss.rename('People Ops Tracker (demo)');
  const order = ['How to use', 'Joiners', 'Leavers', 'Steps', 'Guides', 'Questions'];
  order.forEach((name, i) => {
    let sh = ss.getSheetByName(name) || ss.insertSheet(name, i);
    sh.clear(); sh.clearConditionalFormatRules();
    const rows = DEMO[name]; const w = Math.max(...rows.map(r => r.length));
    const vals = rows.map(r => r.concat(Array(w - r.length).fill('')));
    sh.getRange(1, 1, vals.length, w).setValues(vals);
    if (name === 'How to use') { sh.getRange('A1').setFontWeight('bold').setFontSize(14); sh.setColumnWidth(1, 900); return; }
    sh.getRange(1, 1, 1, w).setFontWeight('bold').setFontColor('#ffffff').setBackground('#1f2937').setWrap(true).setVerticalAlignment('middle');
    sh.setRowHeight(1, 48); sh.setFrozenRows(1); sh.setFrozenColumns(name === 'Joiners' || name === 'Leavers' ? 2 : 1);
    sh.setColumnWidths(1, w, 130);
    if (name === 'Joiners' || name === 'Leavers') {
      const head = vals[0]; const first = head.findIndex(h => /^[JL]\d{2} /.test(h)) + 1;
      sh.setColumnWidth(2, 220); sh.setColumnWidth(head.indexOf('Notes') + 1, 280);
      if (head.indexOf('Shared logins') >= 0) sh.setColumnWidth(head.indexOf('Shared logins') + 1, 260);
      ['Day 0', 'Added on'].forEach(h => sh.getRange(2, head.indexOf(h) + 1, 200, 1).setNumberFormat('yyyy-mm-dd'));
      const pc = head.indexOf('% complete') + 1; const A = c => sh.getRange(1, c).getA1Notation().replace(/\d+/, '');
      for (let r = 2; r <= vals.length; r++) {
        const R = A(first) + r + ':' + A(w) + r;
        sh.getRange(r, pc).setFormula('=IF(COUNTA(' + R + ')-COUNTIF(' + R + ',"N/A")=0,0,COUNTIF(' + R + ',"Done")/(COUNTA(' + R + ')-COUNTIF(' + R + ',"N/A")))').setNumberFormat('0%');
      }
      const steps = sh.getRange(2, first, 200, w - first + 1);
      steps.setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Pending', 'Done', 'Blocked', 'N/A'], true).build());
      sh.getRange(2, head.indexOf('Status') + 1, 200, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Not started', 'Active', 'Test', 'Done', 'Cancelled'], true).build());
      const rule = (v, c) => SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo(v).setBackground(c).setRanges([steps]).build();
      sh.setConditionalFormatRules([rule('Done', '#c6efce'), rule('Blocked', '#ffc7ce'), rule('N/A', '#e7e6e6')]);
    } else {
      sh.getRange(1, 1, vals.length, w).setWrap(true).setVerticalAlignment('top');
      if (name === 'Guides') sh.getRange(2, 3, 50, 1).setNumberFormat('yyyy-mm-dd');
      if (name === 'Steps') { sh.setColumnWidth(2, 300); sh.setColumnWidth(10, 520); }
      if (name === 'Questions') { sh.setColumnWidth(1, 260); sh.setColumnWidth(3, 260); sh.setColumnWidth(4, 420); sh.setColumnWidth(5, 280); }
    }
  });
  const extra = ss.getSheetByName('Sheet1'); if (extra) ss.deleteSheet(extra);
  ss.setActiveSheet(ss.getSheetByName('Joiners'));
}
